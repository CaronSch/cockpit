{
  "name": "cockpit",
  "version": "0.1.0",
  "private": true,
  "description": "In-browser workbench for AI coding harnesses: magnetic, split-tree modular windows (VS Code workbench grid model).",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "start": "bun daemon/main.js",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc -p .",
    "claude-md": "bun scripts/update-claude-md.js",
    "claude-md:check": "bun scripts/update-claude-md.js --check",
    "prepare": "git config core.hooksPath .githooks"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "mermaid": "12.2.0",
    "temml": "0.14.0",
    "uqr": "0.1.3",
    "vega": "6.4.0",
    "vega-lite": "6.5.0"
  }
}
